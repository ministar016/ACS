@startuml act_defence_feedback
title Activity Diagram 2: Defence Action Feedback Loop (Hit / Miss)

skinparam backgroundColor #F0F4F8
skinparam shadowing true
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11

skinparam activity {
  BackgroundColor #EAF4FB
  BorderColor #2471A3
  BorderThickness 2
  FontColor #1A2F45
  DiamondBackgroundColor #FFF9C4
  DiamondBorderColor #E65100
  DiamondFontColor #BF360C
  ArrowColor #4A148C
  ArrowThickness 2
  StartColor #1B3A5C
  EndColor #B71C1C
}

skinparam swimlane {
  BorderColor #555555
  BorderThickness 2
  TitleBackgroundColor #37474F
  TitleFontColor #FFFFFF
  TitleFontStyle bold
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}

|#FFD7D7|Defence Controller|
|#E1D5E7|Target Tracking|
|#DAE8FC|Operator|
|#FFE6CC|Alarm System|
|#D5E8D4|Audit Log|

|Defence Controller|
start
#EF9A9A:Receive action result
from deployed device;
#EF9A9A:Evaluate engagement result;

if (Target neutralized?) then (HIT)

  #C8E6C9:Set action status = SUCCESS;

  |Alarm System|
  #A5D6A7:Resolve alarm
  status = RESOLVED;

  |Target Tracking|
  #C8E6C9:Close target track;
  #C8E6C9:Archive track data;

  |Defence Controller|
  #A5D6A7:Recall device to base;
  #A5D6A7:Set defence status = STANDBY;

  |Operator|
  #C8E6C9:Display: Mission Accomplished
  Target Neutralized;

  |Audit Log|
  #C8E6C9:Record MISSION_ACCOMPLISHED
  {actionId, targetId, duration};
  stop

else (MISS)

  #FFCC80:Set action status = MISS;
  #FFCC80:Analyze miss data
  (deviation, distance, conditions);

  |Target Tracking|
  #E1BEE7:Update track with
  new sensor data;
  #E1BEE7:Confirm target still active;

  if (Target still tracked?) then (yes)

    #CE93D8:Recalculate target position
    and velocity vector;

    |Defence Controller|
    #FFCC80:Request trajectory
    recalculation;
    #FFCC80:Receive new intercept point;
    #FF8A65:Prepare new defence action;

    |Alarm System|
    #FFB74D:Update alarm
    status = RECALCULATING;
    #FFB74D:Update alarm with
    new trajectory;

    |Operator|
    #BBDEFB:Display: MISS
    New intercept calculated;
    #BBDEFB:Present new defence action
    for approval;

    if (Operator approves new action?) then (APPROVE)

      |Defence Controller|
      #EF9A9A:Redeploy device to
      new intercept position;
      #EF9A9A:Set defence status = REDEPLOYED;

      |Audit Log|
      #FFF9C4:Record REDEPLOYMENT
      {newActionId, attempt, timestamp};

      |Defence Controller|
      note right
        Loops back to engagement.
        Repeats until HIT or ABORT.
      end note
      stop

    else (DENY / ABORT)

      |Defence Controller|
      #E0E0E0:Recall device;
      #E0E0E0:Set defence status = STANDBY;

      |Alarm System|
      #FFCDD2:Set alarm
      status = OPERATOR_ABORT;

      |Operator|
      #E0E0E0:Display: Mission aborted
      Returning to monitoring;

      |Audit Log|
      #FFCDD2:Record MISSION_ABORTED
      {alarmId, operatorId, attempts};
      stop

    endif

  else (no — target lost)

    |Defence Controller|
    #E0E0E0:Recall device;
    #E0E0E0:Set defence status = STANDBY;

    |Alarm System|
    #FFE0B2:Set alarm
    status = TARGET_LOST;

    |Operator|
    #E0E0E0:Display: Target lost
    Returning to monitoring;

    |Audit Log|
    #FFE082:Record TARGET_LOST
    {trackId, lastKnownPosition};
    stop

  endif

endif

@enduml
