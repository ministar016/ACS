@startuml act_mission_workflow
title Activity Diagram 1: Full Mission Workflow\n(Detection > Fusion > Decision > Action > Feedback)

skinparam backgroundColor #F0F4F8
skinparam shadowing true
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11

skinparam activity {
  BackgroundColor #EAF4FB
  BorderColor #2471A3
  BorderThickness 2
  FontColor #1A2F45
  DiamondBackgroundColor #FFF9C4
  DiamondBorderColor #E65100
  DiamondFontColor #BF360C
  ArrowColor #1A5276
  ArrowThickness 2
  StartColor #1B3A5C
  EndColor #B71C1C
}

skinparam swimlane {
  BorderColor #555555
  BorderThickness 2
  TitleBackgroundColor #37474F
  TitleFontColor #FFFFFF
  TitleFontStyle bold
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}

|#D5E8D4|Controller 1: Sensor Detection|
|#FFF2CC|Controller 2: Sensor Fusion|
|#FFD7D7|Controller 3: Operator Decision|
|#DAE8FC|Audit Log|

|Controller 1: Sensor Detection|
start
#C8E6C9:Sensors detect activity
(Acoustic, Seismic, Radar, LiDAR, Camera);
#C8E6C9:Pre-process sensor data
(edge filtering, noise reduction);

if (Activity signature detected?) then (yes)
  #A5D6A7:Flag activity and package
  pre-processed data;
  #A5D6A7:Monitor UGV/UAV heading
  in detection zone;

  |Controller 2: Sensor Fusion|
  #FFF9C4:Receive pre-processed data
  from Controller 1;
  #FFF9C4:Fuse multi-sensor data
  (Kalman filter, conflict resolution);
  #FFE082:Run AI/ML model
  on fused data;

  if (Target identified?) then (yes [confidence > 0.85])
    #FFCC80:Classify target type
    and threat level;
    #FFCC80:Initialize target tracking;
    #FFCC80:Estimate target trajectory
    (Kalman prediction);
    #FFCC80:Calculate intercept point;
    #FF8A65:Generate alarm
    with target data + trajectory;

    |Controller 3: Operator Decision|
    #FFCDD2:Operator receives alarm
    (target data, trajectory, map);
    #FFCDD2:Review threat information;

    if (Operator approves action?) then (APPROVE)
      #EF9A9A:Defence system WAKEUP;
      #EF9A9A:Select best UGV/UAV
      for intercept;
      #EF9A9A:Deploy device to
      intercept position;

      |Audit Log|
      #BBDEFB:Record DEFENCE_DEPLOYED
      {actionId, deviceId, timestamp};

      |Controller 3: Operator Decision|
      #FFCDD2:Device approaches target;
      #FFCDD2:Update trajectory in real-time;

      if (Target in range?) then (yes)
        #F48FB1:Request final operator
        confirmation;

        if (Operator confirms?) then (yes)
          #E91E63:Execute defence action;
          #E91E63:Receive action feedback;

          if (Target hit?) then (HIT)
            #C8E6C9:Mission Accomplished;

            |Audit Log|
            #C8E6C9:Record MISSION_ACCOMPLISHED
            {actionId, targetId, timestamp};

            |Controller 3: Operator Decision|
            #A5D6A7:Stand down defence system;
            :Return to monitoring;
            stop

          else (MISS)
            #FFE082:Recalculate trajectory
            with updated data;
            #FFE082:Calculate new intercept point;
            #FFCC80:Propose new defence action;
            #FFCC80:Request operator re-approval;

            |Audit Log|
            #FFF9C4:Record MISS_RECALCULATION
            {actionId, attempt, timestamp};

            |Controller 3: Operator Decision|
            stop
          endif

        else (ABORT)
          #E0E0E0:Recall device;
          :Return to monitoring;

          |Audit Log|
          #E0E0E0:Record ACTION_ABORTED;

          |Controller 3: Operator Decision|
          stop
        endif

      else (no — out of range)
        #E1BEE7:Continue tracking and
        repositioning device;
        stop
      endif

    else (DENY)
      #E0E0E0:Log operator denial;
      #E0E0E0:Resolve alarm;
      :Continue monitoring;

      |Audit Log|
      #FFCDD2:Record ACTION_DENIED
      {alarmId, operatorId, reason};

      |Controller 3: Operator Decision|
      stop
    endif

  else (no — no target)
    |Controller 1: Sensor Detection|
    #E0E0E0:Continue monitoring loop;
    stop
  endif

else (no — no activity)
  #E0E0E0:Continue monitoring loop;
  stop
endif

@enduml
