@startuml seq_sensor_fusion
title Sequence Diagram 2: Sensor Fusion & Target Identification (Controller 2)

skinparam backgroundColor #F0F4F8
skinparam shadowing true
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

skinparam sequence {
  ArrowColor #E65100
  ArrowThickness 2
  LifeLineBorderColor #BF360C
  LifeLineBackgroundColor #FFF8E1
  ParticipantBorderColor #BF360C
  ParticipantBorderThickness 2
  ParticipantFontStyle bold
  DividerBackgroundColor #FFE0B2
  DividerBorderColor #E65100
  GroupBorderColor #4A148C
  GroupBackgroundColor #F3E5F5
  GroupFontColor #4A148C
  NoteBackgroundColor #FFFDE7
  NoteBorderColor #F9A825
  BoxBackgroundColor #FFF3E0
  BoxBorderColor #E65100
}

participant "SensorFusionEngine\n<<Kalman>>" as SFE #FFE082
participant "ThreatDetectionModule\n<<AI/ML>>" as TDM #FFCC80
participant "TargetTracker\n<<tracker>>" as TT  #FF8A65
participant "TrajectoryEstimator\n<<Kalman>>" as TE #FFF9C4
participant "AlarmSystem\n<<alarm>>" as AS #FFCDD2
participant "CommandCenter\n<<control>>" as CC #BBDEFB
actor "Operator" as OP

note over SFE, OP #FFF3E0
  Controller 2: Receives pre-processed data from Controller 1.
  Fuses multi-sensor data, identifies targets with AI,
  estimates trajectory, generates alarm for Operator.
end note

== Sensor Fusion ==
activate SFE #FFD54F
SFE -> SFE : synchronizeTimestamps()
SFE -> SFE : applyKalmanFilter()
SFE -> SFE : mergeDetections()
SFE -> SFE : resolveConflicts()
SFE -> SFE : computeConfidenceScore()

SFE -> TDM : analyzeData(fusedData)
deactivate SFE
activate TDM #FFB74D

== AI Target Identification ==
TDM -> TDM : runMLInference(fusedData)
TDM -> TDM : classifyTarget(result)
TDM -> TDM : computeConfidence()

alt Target Identified (confidence > 0.85)

  TDM -> TDM : identifyTarget()
  TDM -> TDM : classifyThreatLevel()

  == Target Tracking ==
  TDM -> TT : initTrack(detectedTarget)
  activate TT #FF7043
  TT -> TT : assignTrackId()
  TT -> TT : setInitialState(position, velocity)
  TT --> TDM : Track {trackId, position, velocity}
  deactivate TT

  == Trajectory Estimation ==
  TDM -> TE : estimateTrajectory(track)
  activate TE #FFF176
  TE -> TE : applyKalmanPrediction()
  TE -> TE : predictInterceptPoint()
  TE --> TDM : Trajectory {path, interceptPoint, ETA}
  deactivate TE

  == Generate Alarm ==
  TDM -> AS : createAlarm(threat, trajectory)
  activate AS #EF9A9A
  AS -> AS : assignAlarmId()
  AS -> AS : setPriority(threatLevel)
  AS -> CC : broadcastAlarm(alarm)
  activate CC #BBDEFB
  CC --> AS : ack
  deactivate CC
  AS -> OP : notifyOperator(alarm, targetData, map)
  deactivate AS

else No Target (confidence <= 0.85)

  TDM --> SFE : continueMonitoring()

end

deactivate TDM

note over TDM #FFE082
  AI model: ONNX classifier
  Confidence threshold: 0.85
  Classifies: UGV / UAV /
  Person / Vehicle
end note

note over TE #FFF9C4
  Kalman prediction:
  position + velocity vector.
  Intercept point for
  defence positioning.
end note

@enduml
