@startuml package_diagram
title Package Diagram — AMCS Module Organization

skinparam backgroundColor #F0F4F8
skinparam shadowing true
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam roundCorner 8

skinparam package {
  BorderThickness 2
  FontStyle bold
  FontSize 12
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #78909C
  BorderThickness 1
  FontSize 10
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}

skinparam arrow {
  Color #37474F
  Thickness 2
}

package "amcs" #F8FBFF {

  package "amcs.presentation" #BBDEFB {
    package "amcs.presentation.dashboard" #E3F2FD {
      class DashboardController
      class MapViewComponent
      class TelemetryWidget
    }
    package "amcs.presentation.alarms" #FFCDD2 {
      class AlarmConsoleController
      class AlarmListView
      class AlarmDetailView
    }
    package "amcs.presentation.map" #E3F2FD {
      class BattlefieldMapView
      class DeviceMarker
      class ThreatOverlay
      class TrajectoryOverlay
    }
  }

  package "amcs.api" #C8E6C9 {
    package "amcs.api.gateway" #E8F5E9 {
      class GatewayRouter
      class RequestLogger
    }
    package "amcs.api.controllers" #E8F5E9 {
      class CommandController
      class MissionController
      class AlarmController
      class DefenceController
    }
    package "amcs.api.dto" #E8F5E9 {
      class CommandRequest
      class CommandResponse
      class AlarmDTO
      class DefenceActionDTO
    }
  }

  package "amcs.domain" #FFF9C4 {
    package "amcs.domain.command" #FFFDE7 {
      class CommandCenter
      class Command
      class MissionControllerService
    }
    package "amcs.domain.devices" #FFFDE7 {
      abstract class Device
      class UAV
      class UGV
      class DeviceRegistry
    }
    package "amcs.domain.sensors" #FFFDE7 {
      abstract class Sensor
      class AcousticSensor
      class SeismicSensor
      class RadarSensor
      class LiDARSensor
      class CameraSensor
      class SensorFusionEngine
    }
    package "amcs.domain.users" #FFFDE7 {
      class Operator
    }
  }

  package "amcs.processing" #E1BEE7 {
    package "amcs.processing.fusion" #F3E5F5 {
      class SensorFusionPipeline
      class KalmanFilter
      class DataSynchronizer
      class ConflictResolver
    }
    package "amcs.processing.detection" #F3E5F5 {
      class ThreatDetectionModule
      class DetectionRule
      class MLInferenceEngine
      class ThreatClassifier
    }
    package "amcs.processing.tracking" #F3E5F5 {
      class TargetTracker
      class Track
      class TrajectoryEstimator
    }
  }

  package "amcs.defence" #FFCDD2 {
    package "amcs.defence.controller" #FFEBEE {
      class DefenceControllerService
      class DefenceAction
      class ActionFeedback
    }
    package "amcs.defence.alarm" #FFEBEE {
      class AlarmSystem
      class Alarm
      class AlarmPriority
    }
  }

  package "amcs.infrastructure" #ECEFF1 {
    package "amcs.infrastructure.persistence" #F5F5F5 {
      class MissionRepository
      class SensorDataRepository
    }
    package "amcs.infrastructure.crypto" #F5F5F5 {
      class EncryptionService
      class KeyManager
    }
    package "amcs.infrastructure.logging" #F5F5F5 {
      class AuditLog
      class LogEntry
      class AuditLogRepository
    }
  }

}

' ============================================================
' DEPENDENCY RULES
' ============================================================
"amcs.presentation" ..> "amcs.api" : <<import>>
"amcs.api" ..> "amcs.domain" : <<import>>
"amcs.api" ..> "amcs.defence" : <<import>>
"amcs.domain" ..> "amcs.processing" : <<import>>
"amcs.domain" ..> "amcs.infrastructure" : <<access>>
"amcs.processing" ..> "amcs.infrastructure" : <<access>>
"amcs.defence" ..> "amcs.processing" : <<import>>
"amcs.defence" ..> "amcs.domain" : <<import>>
"amcs.defence" ..> "amcs.infrastructure" : <<access>>

note bottom of "amcs.infrastructure" #ECEFF1
  Infrastructure provides:
  persistence, encryption,
  and audit logging for
  all other layers.
end note

note top of "amcs.defence" #FFCDD2
  Defence package orchestrates:
  alarm generation, defence
  actions, and feedback loops.
end note

@enduml
