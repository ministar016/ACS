@startuml component_diagram
title Component Diagram — AMCS System Architecture

skinparam backgroundColor #F0F4F8
skinparam shadowing true
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam roundCorner 8

skinparam component {
  BackgroundColor #EAF4FB
  BorderColor #2471A3
  BorderThickness 2
  FontColor #1A2F45
  ArrowColor #1A5276
  ArrowThickness 2
}

skinparam package {
  BorderThickness 2
  FontStyle bold
  FontSize 12
}

skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #4A148C
  BorderThickness 2
}

skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  BorderThickness 2
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}

' ============================================================
package "Presentation Layer" #BBDEFB {
  [Operator Dashboard UI] as UI #90CAF9
  [Real-Time Map Viewer] as MAP #90CAF9
  [Alarm Console] as CONSOLE #EF9A9A
}

package "Application Layer" #C8E6C9 {
  [API Gateway] as GW #A5D6A7
  [Command & Control Service] as CCS #A5D6A7
  [Mission Controller Service] as MCS #A5D6A7
  [Alarm Service] as ALS #FFCDD2
  [Defence Controller Service] as DCS #EF9A9A
}

package "Processing Layer" #FFF9C4 {
  [Sensor Fusion Engine] as SFE #FFE082
  [Threat Detection Module] as TDM #FFCC80
  [Target Tracking Service] as TTS #FF8A65
  [Trajectory Estimator] as TE  #FFF176
  [AI/ML Inference Engine] as AI #FFD54F
}

package "Device Layer" #E1BEE7 {
  [UAV Communication Adapter] as UAV_A #CE93D8
  [UGV Communication Adapter] as UGV_A #CE93D8
  [Device Registry] as DR #E1BEE7
  [Edge Processor] as EP #FFF176
}

package "Infrastructure Layer" #ECEFF1 {
  [Encryption Service] as ENC #CFD8DC
  [Audit Log Service] as AUDIT #CFD8DC
  database "Mission DB\n<<PostgreSQL>>" as MISSIONDB #A5D6A7
  database "Sensor Data Store\n<<TimescaleDB>>" as SENSORDB #A5D6A7
  database "Audit Database\n<<MongoDB>>" as AUDITDB #A5D6A7
}

' ============================================================
' Interfaces
' ============================================================
interface "REST / WebSocket\n<<HTTPS / TLS 1.3>>" as HTTP_IF
interface "gRPC\n<<mTLS>>" as GRPC_IF
interface "Device Protocol\n<<AES-256 Radio>>" as DEV_IF

' ============================================================
' Connections — Presentation to Application
' ============================================================
UI --> HTTP_IF
MAP --> HTTP_IF
CONSOLE --> HTTP_IF
HTTP_IF --> GW

' ============================================================
' API Gateway to Services
' ============================================================
GW --> CCS
GW --> ALS
GW --> DCS

' ============================================================
' Application Layer internal
' ============================================================
CCS --> ENC : encrypt commands
CCS --> MCS
CCS --> AUDIT : log events
ALS --> CONSOLE : <<notify>>
ALS --> AUDIT : log alarms
ALS --> DCS : activate defence
DCS --> UAV_A : deploy device
DCS --> UGV_A : deploy device

' ============================================================
' Application to Device Layer
' ============================================================
CCS --> UAV_A
CCS --> UGV_A
UAV_A --> DEV_IF
UGV_A --> DEV_IF
UAV_A --> DR : register device
UGV_A --> DR : register device
EP --> SFE : pre-processed data

' ============================================================
' Processing Layer
' ============================================================
SFE --> GRPC_IF
GRPC_IF --> TDM
TDM --> AI : run inference
TDM --> TTS : track target
TDM --> TE : estimate trajectory
TDM --> ALS : create alarm
TE --> DCS : intercept point

' ============================================================
' Data Layer
' ============================================================
MCS --> MISSIONDB
SFE --> SENSORDB : persist fused data
AUDIT --> AUDITDB

note bottom of SFE #FFF9C4
  Consumes pre-processed sensor
  data from edge processors
  on UAV/UGV devices
end note

note top of GW #C8E6C9
  Single entry point for
  operator access.
  Rate limiting + auth.
end note

note right of DCS #FFCDD2
  Defence Controller manages:
  Wakeup > Deploy > Engage
  cycle for UGV/UAV defence
end note

@enduml
