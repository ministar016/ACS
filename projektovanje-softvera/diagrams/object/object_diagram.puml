' ============================================================
' LINKS
' ============================================================
MISS "controls" -- UAV_A
MISS "controls" -- UGV
MISS "controls" -- PVO
MISS "controls" -- GG
MISS "monitors" -- ACO
MISS "monitors" -- SEI
OP "monitors" -- MISS
OP "approved" ..> ACTION

UAV_A "has sensor" -- RADAR_UAV
UAV_A "has sensor" -- CAM_UAV
UGV "has sensor" -- RADAR_UGV
UGV "has sensor" -- CAM_UGV

ALARM "triggered" ..> ACTION
ACTION "targets" ..> TRACK
TRACK "estimated by" ..> TRAJ
UGV "deployed for" ..> ACTION

