@startuml object_diagram
title Object Diagram — AMCS Runtime Instances\n(Active Mission MSN-2026-003, 2026-03-21 14:32 UTC)\nZone: 42.817–42.843°N / 20.166–20.534°E  [30 × 3 km corridor]

skinparam backgroundColor #F0F4F8
skinparam shadowing true
skinparam defaultFontName Helvetica
skinparam defaultFontSize 10
skinparam roundCorner 8

skinparam object {
  BackgroundColor #EAF4FB
  BorderColor #2471A3
  BorderThickness 2
  FontColor #1A2F45
  ArrowColor #37474F
  ArrowThickness 2
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}

' ============================================================
' MISSION & OPERATOR
' ============================================================
together {
  object "mission_03 : MissionController" as MISS #BBDEFB {
    missionId = "MSN-2026-003"
    status = MissionStatus.ACTIVE
    startTime = "2026-03-21T14:00:00Z"
    assignedZone = "ZONE-BRAVO"
    corridorBounds = "42.817-42.843°N / 20.166-20.534°E"
  }

  object "op_jovic : Operator" as OP #ECEFF1 {
    operatorId = "OP-0042"
    username = "jovic.m"
    clearanceLevel = 3
    assignedZone = "ZONE-BRAVO"
  }
}

' ============================================================
' STANDALONE FIELD SENSORS — Acoustic [x3]
' Distributed evenly along 30 km corridor
' ============================================================
together {
  object "acoustic_field : AcousticSensor  [x3]" as ACO #FFF9C4 {
    sensorId = "ACO-FIELD-{01..03}"
    locations = "W:(42.824,20.195)  C:(42.833,20.350)  E:(42.821,20.500)"
