@startuml class_diagram
title Autonomous Multi-Sensor Command System\nClass Diagram

skinparam backgroundColor #F0F4F8
skinparam shadowing true
skinparam defaultFontName Helvetica
skinparam defaultFontSize 10
skinparam classAttributeIconSize 0
skinparam roundCorner 8

skinparam class {
  BackgroundColor #EAF4FB
  BorderColor #2471A3
  BorderThickness 2
  HeaderBackgroundColor #2471A3
  FontColor #1A2F45
  AttributeFontColor #1A2F45
  ArrowColor #1A5276
  ArrowThickness 2
  FontStyle bold
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}

skinparam package {
  BorderThickness 2
  FontStyle bold
  FontSize 12
}

' ============================================================
' PACKAGE: User Management
' ============================================================
package "User Management" #ECEFF1 {

  class Operator #ECEFF1 {
    - operatorId : String
    - username : String
    - assignedZone : String
    - clearanceLevel : Integer
    - lastLogin : DateTime
    + login(credentials) : AuthToken
    + logout() : void
    + monitorZone() : ZoneStatus
    + reviewAlarm(alarm) : AlarmDetails
    + approveAction(action) : Boolean
    + denyAction(action) : Boolean
    + assessFeedback(feedback) : Decision
  }
}

' ============================================================
' PACKAGE: Command & Control
' ============================================================
package "Command & Control" #BBDEFB {

  class CommandCenter #BBDEFB {
    - centerId : String
    - location : GeoCoordinate
    - activeOperators : List<Operator>
    - connectedDevices : List<Device>
    + issueCommand(cmd) : CommandStatus
    + receiveData(data) : void
    + broadcastAlarm(alarm) : void
    + getSystemStatus() : SystemStatus
  }

  class Command #BBDEFB {
    - commandId : String
    - type : CommandType
    - payload : byte[]
    - timestamp : DateTime
    - isEncrypted : Boolean
    - targetDeviceId : String
    + encrypt() : EncryptedCommand
    + validate() : Boolean
    + serialize() : byte[]
  }

  class MissionController #BBDEFB {
    - missionId : String
    - status : MissionStatus
    - assignedDevices : List<Device>
    - objectives : List<Objective>
    + startMission() : void
    + pauseMission() : void
    + abortMission() : void
    + updateObjective(obj) : void
  }
}

' ============================================================
' PACKAGE: Autonomous Vehicles
' ============================================================
package "Autonomous Vehicles" #C8E6C9 {

  abstract class Device #C8E6C9 {
    - deviceId : String
    - type : DeviceType
    - role : DeviceRole
    - status : DeviceStatus
    - location : GeoCoordinate
    - batteryLevel : Float
    + connect() : Boolean
    + disconnect() : void
    + sendTelemetry() : TelemetryData
    + receiveCommand(cmd) : void
  }

  class UAV #C8E6C9 {
    - altitude : Float
    - speed : Float
    - heading : Float
    + takeOff(altitude) : void
    + land() : void
    + setWaypoints(waypoints) : void
    + flyToInterceptPosition(pos) : void
  }

  class UGV #C8E6C9 {
    - terrainMode : TerrainMode
    - speed : Float
    - obstacleDetected : Boolean
    + navigate(destination) : void
    + stop() : void
    + driveToInterceptPosition(pos) : void
  }
}

' ============================================================
' PACKAGE: Sensor Layer
' ============================================================
package "Sensor Layer" #FFF9C4 {

  abstract class Sensor #FFF9C4 {
    - sensorId : String
    - type : SensorType
    - samplingRate : Float
    - location : GeoCoordinate
    - mountedOn : Device
    + startCapture() : void
    + stopCapture() : void
    + getData() : SensorData
    + calibrate() : void
    + isStandalone() : Boolean
  }

  note right of Sensor #FFF9C4
    Acoustic and Seismic sensors
    are standalone field units
    (mountedOn = null).
    Radar + Camera mounted on
    both UAV (PVO) and UGV.
  end note

  class AcousticSensor #FFF9C4 {
    - frequencyRange : FrequencyRange
    - sensitivity : Float
    + detectSound() : AcousticSignature
    + classifySource(sig) : SourceType
  }

  class SeismicSensor #FFF9C4 {
    - sensitivity : Float
    - depthRange : Float
    + detectVibration() : SeismicData
    + classifyMovement(data) : MovementType
  }

  class RadarSensor #FFF9C4 {
    - range : Float
    - frequency : Float
    + detectTargets() : List<RadarTarget>
    + measureDistance(target) : Float
    + trackVelocity(target) : Float
  }

  class LiDARSensor #FFF9C4 {
    - pointsPerSecond : Integer
    - range : Float
    + generatePointCloud() : PointCloud
    + map3DEnvironment() : Map3D
  }

  class CameraSensor #FFF9C4 {
    - resolution : Resolution
    - fps : Integer
    - nightVision : Boolean
    + captureFrame() : Frame
    + startVideoStream() : Stream
    + detectObjects() : List<DetectedObject>
  }

  class SensorFusionEngine #FFE082 {
    - sensors : List<Sensor>
    - fusionAlgorithm : FusionAlgorithm
    + fuseData(dataSet) : FusedData
    + detectAnomalies(data) : FusedData
    + applyKalmanFilter(data) : SensorData
  }
}

' ============================================================
' PACKAGE: Threat Detection & Tracking
' ============================================================
package "Threat Detection & Tracking" #E1BEE7 {

  class ThreatDetectionModule #E1BEE7 {
    - rules : List<DetectionRule>
    - mlModel : ThreatModel
    + analyzeData(data) : List<Threat>
    + classifyThreat(threat) : ThreatLevel
    + identifyTarget(data) : TargetIdentification
  }

  class TargetTracker #E1BEE7 {
    - trackedTargets : Map<String, Target>
    - trackingAlgorithm : TrackingAlgorithm
    + initTrack(target) : Track
    + updateTrack(trackId, data) : void
    + lostTrack(trackId) : void
    + getPredictedPosition(trackId) : GeoCoordinate
  }

  class TrajectoryEstimator #CE93D8 {
    - kalmanFilter : KalmanFilter
    + estimateTrajectory(track) : Trajectory
    + predictInterceptPoint(traj) : GeoCoordinate
    + recalculateTrajectory(track, feedback) : Trajectory
  }
}

' ============================================================
' PACKAGE: Defence System
' ============================================================
package "Defence System" #FFCDD2 {

  class DefenceController #FFCDD2 {
    - status : DefenceStatus
    - assignedDevices : List<Device>
    + wakeup() : void
    + getReady(target) : void
    + deployToIntercept(device, position) : void
    + executeAction(action) : ActionResult
    + standDown() : void
  }

  class AlarmSystem #FFCDD2 {
    - activeAlarms : List<Alarm>
    + createAlarm(threat, trajectory) : Alarm
    + escalateAlarm(alarm) : void
    + resolveAlarm(alarmId) : void
    + notifyOperator(alarm) : void
  }

  class DefenceAction #EF9A9A {
    - actionId : String
    - type : ActionType
    - targetId : String
    - interceptPosition : GeoCoordinate
    - status : ActionStatus
    + approve(operatorId) : void
    + deny(operatorId, reason) : void
    + execute() : ActionResult
  }

  class ActionFeedback #EF9A9A {
    - feedbackId : String
    - actionId : String
    - result : ActionResult
    - hitOrMiss : Boolean
    - timestamp : DateTime
    + evaluate() : FeedbackAssessment
    + triggerRecalculation() : void
  }

  abstract class WeaponSystem #FFCDD2 {
    - systemId : String
    - type : SystemType
    - status : SystemStatus
    - location : GeoCoordinate
    - ammoCount : Integer
    + arm() : void
    + standDown() : void
    + executeEngagement(action) : ActionResult
    + reportStatus() : SystemStatus
  }

  class PVOSystem #EF9A9A {
    - maxAltitude : Float
    - trackingRadar : Boolean
    - engagementRange : Float
    + trackAirTarget(track) : void
    + launchIntercept(target) : ActionResult
  }

  class GroundSystem #CE93D8 {
    - maxRange : Float
    - terrainFollowing : Boolean
    + engageGroundTarget(target) : ActionResult
    + calculateFireSolution(traj) : FireSolution
  }
}

' ============================================================
' PACKAGE: Infrastructure
' ============================================================
package "Infrastructure" #ECEFF1 {

  class EncryptionService #ECEFF1 {
    - algorithm : EncryptionAlgorithm
    - keySize : Integer
    + encrypt(data) : byte[]
    + decrypt(data) : byte[]
    + generateKey() : EncryptionKey
  }

  class AuditLog #ECEFF1 {
    - logId : String
    - entries : List<LogEntry>
    + logEvent(event) : void
    + query(filter) : List<LogEntry>
  }
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' Inheritance
Device <|-- UAV
Device <|-- UGV

Sensor <|-- AcousticSensor
Sensor <|-- SeismicSensor
Sensor <|-- RadarSensor
Sensor <|-- LiDARSensor
Sensor <|-- CameraSensor

WeaponSystem <|-- PVOSystem
WeaponSystem <|-- GroundSystem

' UAV (PVO) carries Radar + Camera; UGV carries Radar + Camera
' Acoustic/Seismic are standalone field units (mountedOn = null)
UAV "1" *-- "1..*" RadarSensor : carries >
UAV "1" *-- "1..*" CameraSensor : carries >
UGV "1" *-- "1..*" RadarSensor : carries >
UGV "1" *-- "1..*" CameraSensor : carries >

' Associations — Command & Control
CommandCenter "1" --> "1..*" Operator : managed by >
CommandCenter "1" --> "1..*" Device : monitors >
CommandCenter "1" --> "1..*" WeaponSystem : controls >
CommandCenter "1" --> "1" MissionController : delegates to >
CommandCenter "1" --> "1" AlarmSystem : uses >
CommandCenter "1" --> "1" AuditLog : logs via >
MissionController "1" --> "1..*" Command : issues >

' Associations — Sensor Processing Chain
SensorFusionEngine "1" --> "1..*" Sensor : aggregates >
SensorFusionEngine "1" --> "1" ThreatDetectionModule : feeds >

' Associations — Threat & Tracking
ThreatDetectionModule "1" --> "1" TargetTracker : delegates tracking >
ThreatDetectionModule "1" --> "0..*" AlarmSystem : triggers >
TargetTracker "1" --> "1" TrajectoryEstimator : estimates trajectory >

' Associations — Defence
AlarmSystem "1" --> "1" DefenceController : activates >
AlarmSystem "1" --> "1..*" Operator : notifies >
DefenceController "1" --> "0..*" DefenceAction : creates >
DefenceController "1" --> "1..*" Device : deploys >
DefenceController "1" --> "1..*" WeaponSystem : fires >
Operator "1..*" --> "0..*" DefenceAction : approves/denies >
DefenceAction "1" --> "1" ActionFeedback : produces >
ActionFeedback "1" --> "1" TrajectoryEstimator : triggers recalculation >

' Infrastructure
EncryptionService ..> Command : <<encrypts>>

' ============================================================
' TAGGED VALUES
' ============================================================
note bottom of ThreatDetectionModule #E1BEE7
  {mlFramework = ONNX Runtime}
  {confidenceThreshold = 0.85}
  {targetClasses = UGV|UAV|Person|Vehicle}
end note

note bottom of TrajectoryEstimator #FFF9C4
  {algorithm = Kalman Filter}
  {predictionHorizon = 5s}
  {updateRate = 10Hz}
end note

note bottom of SensorFusionEngine #FFF9C4
  {samplingRate = 10Hz}
  {protocol = gRPC / mTLS}
  {bandwidthReduction = ~80%}
end note

note bottom of DefenceController #FFCDD2
  {responseMode = human-in-the-loop}
  {encryptedComms = AES-256-GCM}
  {confirmationSteps = 2}
end note

@enduml
